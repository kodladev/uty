{
  "name": "uty",
  "version": "0.2.2",
  "description": "JS utils library",
  "keywords": [
    "js",
    "javascript",
    "util",
    "utils",
    "helper",
    "helpers",
    "collect",
    "define",
    "event",
    "is",
    "math",
    "string",
    "to",
    "type"
  ],
  "bugs": {
    "url": "https://github.com/kodladev/uty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodladev/uty.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kodla",
    "email": "dev@kodla.net",
    "url": "https://kodla.net"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./type/index.d.ts",
      "default": "./src/index.js"
    },
    "./collect": {
      "types": "./type/index.d.ts",
      "default": "./src/collect.js"
    },
    "./define": {
      "types": "./type/index.d.ts",
      "default": "./src/define.js"
    },
    "./event": {
      "types": "./type/index.d.ts",
      "default": "./src/event.js"
    },
    "./is": {
      "types": "./type/index.d.ts",
      "default": "./src/is.js"
    },
    "./math": {
      "types": "./type/index.d.ts",
      "default": "./src/math.js"
    },
    "./string": {
      "types": "./type/index.d.ts",
      "default": "./src/string.js"
    },
    "./to": {
      "types": "./type/index.d.ts",
      "default": "./src/to.js"
    },
    "./type": {
      "types": "./type/index.d.ts",
      "default": "./src/type.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./type/index.d.ts",
  "files": [
    "src",
    "type",
    "./*.d.ts"
  ],
  "scripts": {
    "prebuild": "rimraf type *.d.ts -g",
    "build": "node build",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "25.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
